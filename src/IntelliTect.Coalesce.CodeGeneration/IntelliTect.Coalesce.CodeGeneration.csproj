<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Common.props" />
  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputType>Library</OutputType>
    <Description>Core code generation engine and services for Coalesce. Learn more at https://coalesce.intellitect.com/</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Analysis/MsBuild/Targets/Imports.targets"
                      LogicalName="$(AssemblyName).Analysis.MsBuild.Targets.Imports.targets" />
    <EmbeddedResource Include="Analysis/MsBuild/Targets/build/IntelliTect.Coalesce.CodeGeneration.Analysis.MsBuild.targets"
                      LogicalName="$(AssemblyName).Analysis.MsBuild.Targets.build.IntelliTect.Coalesce.CodeGeneration.Analysis.MsBuild.targets" />
    <EmbeddedResource Include="Analysis/MsBuild/Targets/buildMultiTargeting/IntelliTect.Coalesce.CodeGeneration.Analysis.MsBuild.targets"
                      LogicalName="$(AssemblyName).Analysis.MsBuild.Targets.buildMultiTargeting.IntelliTect.Coalesce.CodeGeneration.Analysis.MsBuild.targets" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IntelliTect.Coalesce\IntelliTect.Coalesce.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.Cli.Utils" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration" />
  </ItemGroup>
</Project>
