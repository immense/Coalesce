<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Common.props" />
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Core library for IntelliTect Coalesce. Learn more at https://coalesce.intellitect.com/</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>

    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\IntelliTect.Coalesce.Analyzer\IntelliTect.Coalesce.Analyzer.csproj"
      PrivateAssets="all"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="OpenTelemetry" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals($(TargetFramework.TrimStart('net')), '9.0'))">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Application\SecurityOverview.html" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None
      Include="..\IntelliTect.Coalesce.Analyzer\bin\$(Configuration)\netstandard2.0\IntelliTect.Coalesce.Analyzer.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false" />
    <None Include="build\IntelliTect.Coalesce.targets" Pack="true" PackagePath="build\IntelliTect.Coalesce.targets" />
    <None Include="buildTransitive\IntelliTect.Coalesce.targets" Pack="true" PackagePath="buildTransitive\IntelliTect.Coalesce.targets" />
    <None
      Include="..\IntelliTect.Coalesce.CodeGeneration.Vue\bin\$(Configuration)\net8.0\*.dll"
      Pack="true"
      PackagePath="tasks\net8.0"
      Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Application\SecurityOverview.html" />
  </ItemGroup>

  <Target Name="BuildCoalesceSourceGenerationTaskAssembly" BeforeTargets="Pack" Condition="'$(NoBuild)' != 'true'">
    <MSBuild
      Projects="..\IntelliTect.Coalesce.CodeGeneration.Vue\IntelliTect.Coalesce.CodeGeneration.Vue.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);TargetFramework=net8.0" />
  </Target>
</Project>
